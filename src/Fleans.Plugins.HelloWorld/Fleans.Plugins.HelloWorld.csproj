<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- This project demonstrates the "author your own custom-task plugin" pattern.
         Direct dependency closure: Fleans.Worker (the leaf NuGet that carries
         CustomTaskHandlerBase + AddCustomTaskPlugin + [ImplicitStreamSubscription]
         attribute marker). Transitively brings Fleans.Application.Abstractions +
         Fleans.Domain.Abstractions only — NO engine internals. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fleans.Worker" Version="0.5.0" />
  </ItemGroup>

</Project>
