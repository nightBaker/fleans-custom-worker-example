<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <UserSecretsId>fleans-custom-worker-example-9c6f43b0</UserSecretsId>
    <!-- Worked example of a custom-task worker: a generic host that connects to a Fleans API over
         gRPC. Dependency closure: Fleans.ExternalTasks.Sdk plus the plugins it serves. No Orleans
         and no engine projects (CI guards it). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fleans.ExternalTasks.Sdk" Version="0.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Worked-example plugin authored in this repo. A real worker references its own plugin
         projects here, or the NuGet packages of ready-made ones such as Fleans.Plugins.RestCaller. -->
    <ProjectReference Include="..\Fleans.Plugins.HelloWorld\Fleans.Plugins.HelloWorld.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
