<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <UserSecretsId>fleans-custom-worker-example-9c6f43b0</UserSecretsId>
    <!-- Worked example for the "host your own custom-task plugins" pattern.
         Dependency closure here is intentionally minimal: Fleans.Worker (the leaf NuGet)
         + the plugin packages your host claims + Orleans server + Aspire telemetry.
         No reference to Fleans.Application / Fleans.Domain / Fleans.Persistence — that
         is the structural guarantee the leaf-package design buys you.
         To verify: dotnet list package (with the transitive flag) should show no Fleans.Domain
         (only Fleans.Domain.Abstractions) and no Fleans.Application (only Fleans.Application.Abstractions). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Fleans plugin host surface.
         v0.3.0 introduced the 'Plugin' role + AddFleansPluginHost helper that this
         Program.cs depends on.
         v0.4.0 introduced per-task-type stream namespaces (#566) — plugin handlers MUST
         declare [ImplicitStreamSubscription("events.ExecuteCustomTaskEvent.<taskType>")]
         as a literal string (see README "Add your own plugin" for the v0.4.0 shape).
         AddCustomTaskPlugin validates the literal at silo startup and throws on drift.
         v0.4.0 also routes OperationCanceledException from the supplied grain-lifetime
         CancellationToken as a redelivery hint (NOT a failure) — plugin authors should
         `await` against the token (e.g. `await Task.Delay(timeout, ct)`) so the grain
         can deactivate cleanly during silo shutdown. -->
    <PackageReference Include="Fleans.Worker" Version="0.4.0" />
    <PackageReference Include="Fleans.Plugins.RestCaller" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Orleans server stack — Server brings Redis clustering/persistence + reminder service. -->
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Clustering.Redis" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Redis" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.0.1" />
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.1.1" />
    <!-- Redis Streams provider — durable Orleans streaming over the same orleans-redis
         connection. Matches the engine's default in v0.3.0+. Date-versioned (YYYY.M.D);
         bump deliberately. MIT licensed, Orleans 10.x compatible. -->
    <PackageReference Include="Universley.OrleansContrib.StreamsProvider.Redis" Version="2026.4.19" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal Aspire service-defaults stack (inlined in Program.cs).
         OpenTelemetry + service discovery + standard HTTP resilience. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.1.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
  </ItemGroup>

</Project>
